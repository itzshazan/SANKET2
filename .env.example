# ==============================================================================
# SANKET — AI Landslide Early Warning System (.env.example)
# Multi-Source Geospatial Ingestion & ML Pipeline Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NASA GPM IMERG (Global Precipitation Measurement)
# Source: NASA Earthdata (GES DISC) — https://urs.earthdata.nasa.gov
# ------------------------------------------------------------------------------
NASA_EARTHDATA_USERNAME=your_nasa_earthdata_username
NASA_EARTHDATA_PASSWORD=your_nasa_earthdata_password
NASA_EARTHDATA_TOKEN=your_earthdata_bearer_token_if_generated
NASA_GPM_PRODUCT=GPM_3IMERGHHL_07

# ------------------------------------------------------------------------------
# 2. NASA SMAP (Soil Moisture Active Passive)
# Source: NASA Earthdata (NSIDC DAAC) — https://urs.earthdata.nasa.gov
# (Reuses NASA_EARTHDATA_USERNAME / NASA_EARTHDATA_PASSWORD / NASA_EARTHDATA_TOKEN)
# ------------------------------------------------------------------------------
NASA_SMAP_PRODUCT=SPL3SMP_E_006

# ------------------------------------------------------------------------------
# 3. Copernicus DEM (Digital Elevation Model 30m / GLO-30)
# Source: Copernicus Data Space Ecosystem (CDSE) or OpenTopography
# ------------------------------------------------------------------------------
COPERNICUS_CLIENT_ID=your_copernicus_client_id
COPERNICUS_CLIENT_SECRET=your_copernicus_client_secret
COPERNICUS_API_KEY=your_copernicus_api_key
OPENTOPOGRAPHY_API_KEY=your_opentopography_key_if_applicable

# ------------------------------------------------------------------------------
# 4. Auxiliary APIs (Open-Meteo & OpenStreetMap)
# ------------------------------------------------------------------------------
OPEN_METEO_API_KEY=
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter

# ------------------------------------------------------------------------------
# 5. Service & Frontend Ports
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
MODULE1_HOST=0.0.0.0
MODULE1_PORT=8000
MODULE1_DEBUG=true
